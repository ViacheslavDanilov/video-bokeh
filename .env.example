# Read by `docker compose` from the repository root (compose.yaml lives here).

# Where generated data lives. Defaults to backend/data; any absolute path works.
# VIDEO_BOKEH_DATA_ROOT=/mnt/4tb/video-bokeh

# What the api serves, when it is not $VIDEO_BOKEH_DATA_ROOT/library: one library, such
# as data/library_dev, or a directory of them. Inside the container the mount always lands
# at /data/library, which is where the api looks by default, so this is a host-side setting
# only.
# VIDEO_BOKEH_LIBRARY=./backend/data/library_dev
