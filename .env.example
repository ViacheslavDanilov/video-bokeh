# Read by `docker compose` from the repository root (compose.yaml lives here).

# Where generated data lives. Defaults to backend/data; any absolute path works.
# VIDEO_BOKEH_DATA_ROOT=/mnt/4tb/video-bokeh

# The library the api serves, when it is not $VIDEO_BOKEH_DATA_ROOT/library. The
# libraries on disk are not called "library" -- data/library_dev is the one a fresh
# clone can build -- so this is how you point compose at an existing one. Inside the
# container the mount always lands at /data/library, which is where the api looks by
# default, so this is a host-side setting only.
# VIDEO_BOKEH_LIBRARY=./backend/data/library_dev
