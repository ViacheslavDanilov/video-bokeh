# Data & Models
backend/models/*.joblib
backend/models/*.pkl
backend/models/any_to_bokeh/
backend/data/*/
!backend/data/*_dev/
# Laid out like magick_dev/, without the images: the CLIP predictions on MAGICK took a GPU
# to make, and the metadata names the images they cover. A full mirror's images stay out.
!backend/data/magick/
backend/data/magick/*
!backend/data/magick/metadata.csv
!backend/data/magick/predictions.csv
!backend/data/magick/images/
backend/data/magick/images/*
!backend/data/magick/images/.gitkeep
backend/data/synth*/
backend/data/library*/

# Third-party tool venvs and locally downloaded checkpoints
backend/third_party/.venv/
backend/third_party/*/checkpoints/
backend/third_party/*/gdino_checkpoints/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code. The skills and the push-blocking hook are shared working
# agreements -- AGENTS.md already points at .claude/settings.json -- so they are
# tracked. Per-machine overrides and local state are not.
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json

# gstack QA reports and screenshots, written by the qa skill
.gstack/

# Personal docs working area. `docs/` is the Obsidian vault root; the shared
# folders (explanation/how-to/reference) plus README and STYLE are tracked,
# everything below is local-only. A new personal folder needs a new line.
docs/meetings/
docs/reports/
docs/specs/
docs/plans/
docs/templates/
docs/attachments/
docs/dashboard.md
docs/.obsidian/
docs/.smart-env/

.DS_Store

# Superseded docs, kept locally until reviewed and deleted by hand.
docs/deprecated/

# Playwright MCP scratch output (screenshots, snapshots, console logs)
.playwright-mcp/
