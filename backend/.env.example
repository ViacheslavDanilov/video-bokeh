# Backend (FastAPI)
#
# Nothing loads this file automatically -- there is no dotenv in the backend. It is a
# record of what the process reads from its environment, so export these or pass them
# on the command line:
#
#   VIDEO_BOKEH_LIBRARY=data/library_dev uv run uvicorn video_bokeh.api.main:app
#
# Under docker compose the values come from the root .env.example instead, and the
# api service already has them set. See docs/reference/api.md.

# What the API serves: one library, such as data/library_dev, or a directory of them.
# Defaults to $VIDEO_BOKEH_DATA_ROOT/library.
# VIDEO_BOKEH_LIBRARY=data/library_dev

# Where generated sequences are written. Defaults to `data`, relative to backend/.
# VIDEO_BOKEH_DATA_ROOT=data

# Comma-separated origins a browser may call the API from. The page and the API are
# always on different ports, so an origin that is not listed is refused before the
# request reaches a route. Defaults to the dev frontend, which is the line below, so
# set this only when the page is served from somewhere else.
# Read once at startup, unlike the paths above.
# CORS_ORIGINS=http://localhost:3000

# Whether a generated sequence comes with its bokeh, rendered by the layered renderer in
# the same request. On by default, and only ever when torch is installed; 0 turns it off.
# VIDEO_BOKEH_RENDER_BOKEH=1

# The torch device that bokeh renders on: cpu, mps or cuda. Read by the layered renderer,
# here and in Stage C; a device that is not there falls back to the CPU.
# VIDEO_BOKEH_LAYERED_DEVICE=cpu
