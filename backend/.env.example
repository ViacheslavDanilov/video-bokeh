# Backend (FastAPI)

# LLM API keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# CORS (comma-separated origins allowed to call the API)
# CORS_ORIGINS=http://localhost:3000

# Where generated data lives. Defaults to backend/data; any absolute path works.
# VIDEO_BOKEH_DATA_ROOT=/mnt/4tb/video-bokeh
