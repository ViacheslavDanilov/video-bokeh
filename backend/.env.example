# Backend (FastAPI)
#
# Nothing loads this file automatically -- there is no dotenv in the backend. It is a
# record of what the process reads from its environment, so export these or pass them
# on the command line:
#
#   VIDEO_BOKEH_LIBRARY=data/library_dev uv run uvicorn video_bokeh.api.main:app
#
# Under docker compose the values come from the root .env.example instead, and the
# api service already has them set. See docs/reference/api.md.

# The library the API serves. Defaults to $VIDEO_BOKEH_DATA_ROOT/library, which is not
# what any library on disk is called -- data/library_dev is the one a fresh clone can
# build.
# VIDEO_BOKEH_LIBRARY=data/library_dev

# Where generated scenes are written. Defaults to `data`, relative to backend/.
# VIDEO_BOKEH_DATA_ROOT=data

# CORS (comma-separated origins allowed to call the API).
# NOT READ YET: the app installs no CORS middleware, so setting this does nothing
# today. The frontend at :3000 calling the API at :8000 is cross-origin, so wiring it
# is the first thing the browser will demand.
# CORS_ORIGINS=http://localhost:3000
